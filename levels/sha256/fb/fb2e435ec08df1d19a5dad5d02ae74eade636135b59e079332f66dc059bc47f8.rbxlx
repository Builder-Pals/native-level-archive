		<Item class="Script" referent="RBX14">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Person299&apos;s Anti Cursing Script</string>
				<ProtectedString name="Source">--Person299
wordlist = {  }--Set this to the words you want people to not be able to use
warnings = 1--Set this to how many warnings you want someone to get before they&apos;re banned

playerlist = { }
offenses = { }
banlist = { }

function oc(msg,speaker)
for i=1,#wordlist do
if string.lower(wordlist[i]) == string.lower(msg) then
local onum = 0
for i2=1,#playerlist do
if playerlist[i2] == speaker.Name then
offenses[i2] = offenses[i2] + 1
onum = offenses[i2]
break
end end
if onum &gt; warnings then
table.insert(banlist,speaker.Name)
speaker:remove()
else
local m = Instance.new(&quot;Message&quot;)
if warnings + 1 - onum == 1 then
m.Text = &quot;1 more curse and you will be banned.&quot;
else
m.Text = warnings + 1 - onum .. &quot; more curses and you will be banned.&quot;
end
m.Parent = speaker
wait(3)
if m ~= nil then
m:remove()
end end
return
end end end
game.Players.ChildAdded:connect(function(guy) if guy.className == &quot;Player&quot; then for i=1,#banlist do if banlist[i] == guy.Name then guy:remove() return end end table.insert(playerlist,guy.Name) table.insert(offenses,0) guy.Chatted:connect(function(msg) oc(msg,guy) end) end end)
game.Players.ChildRemoved:connect(function(guy) if guy.className == &quot;Player&quot; then for i=1,#playerlist do if playerlist[i] == guy.Name then table.remove(playerlist,i) table.remove(offenses,i) end end end end)</ProtectedString>
			</Properties>
