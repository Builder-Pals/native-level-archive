							<ProtectedString name="Source">victim = script.Parent.Parent.Parent.Parent.Parent.Character

function kill()
&#9;v =  victim:GetChildren()
&#9;for f = 1,#v do
&#9;&#9;if v[f].className == &quot;CharacterMesh&quot; then
&#9;&#9;&#9;v[f]:Remove()
&#9;&#9;end
&#9;end
&#9;p = script:GetChildren()
&#9;for i = 1,#p do
&#9;&#9;if p[i].className == &quot;CharacterMesh&quot; then
&#9;&#9;&#9;p[i]:clone().Parent = victim
&#9;&#9;end
&#9;end
end

