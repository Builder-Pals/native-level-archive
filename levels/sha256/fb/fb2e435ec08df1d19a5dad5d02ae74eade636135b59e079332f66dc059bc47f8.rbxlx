									<ProtectedString name="Source">bin = script.Parent
box = script.Parent.Parent

local flipper = script.Parent

local debounce = false
function onTouch(part)
&#9;if debounce == true then return end

&#9;debounce = true
&#9;flipper.BrickColor = BrickColor.new(26)
&#9;
&#9;box.P12.BrickColor = BrickColor.new(26)

&#9;if box.P20.BrickColor == BrickColor.new(21) then
&#9;
&#9;wait(0.1)
&#9;box.P12.BrickColor = BrickColor.new(24)
&#9;box.P20.BrickColor = BrickColor.new(104)
&#9;box.Points.Value.Value = box.Points.Value.Value + 1
&#9;wait(0.1)
&#9;box.P20.BrickColor = BrickColor.new(194)

&#9;debounce = false
&#9;flipper.BrickColor = BrickColor.new(21)

&#9;else

&#9;wait(0.1)
&#9;box.P12.BrickColor = BrickColor.new(24)
&#9;box.P20.BrickColor = BrickColor.new(26)
&#9;wait(0.1)
&#9;box.P20.BrickColor = BrickColor.new(194)

&#9;debounce = false
&#9;flipper.BrickColor = BrickColor.new(21)
&#9;end
end


