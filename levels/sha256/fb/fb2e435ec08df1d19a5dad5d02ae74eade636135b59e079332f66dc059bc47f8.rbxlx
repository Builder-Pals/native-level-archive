							<int name="BrickColor">199</int>
							<CoordinateFrame name="CFrame">
								<X>-110.514191</X>
								<Y>44.485302</Y>
								<Z>-2023.55725</Z>
								<R00>1</R00>
								<R01>3.49388074e-010</R01>
								<R02>9.20629191e-007</R02>
