		<Item class="Script" referent="RBX4496">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Scoutywouty&apos;s Anti ODer script</string>
				<ProtectedString name="Source">wordlist = {&quot;i love you&quot;,&quot;wanna go out?&quot;,&quot;wanna go out&quot;,&quot;want to go out&quot;,&quot;wan&apos;t to go out?&quot;,&quot;wanna make out?&quot;,&quot;wanna make out&quot;,&quot;i need a gf&quot;,&quot;gf&quot;,&quot;anyone need a bf?&quot;,&quot;anyone need a gf?&quot;,&quot;i need a bf&quot;,&quot;lets kiss&quot;,&quot;bf&quot;,&quot;lets make out&quot;,&quot;ill be your bf&quot;,&quot;ill be your gf&quot;,&quot;your hot&quot;,&quot;you are hot&quot;,&quot;you&apos;re hot&quot;,&quot;your hot!&quot;,&quot;you&apos;re hot!&quot;,&quot;you are hot!&quot;,&quot;humps&quot;,&quot;t-bags&quot;,&quot;t bags&quot;,&quot;lets have it&quot;}--Set this to the words you want people to not be able to use
warnings = 1--Set this to how many warnings you want someone to get before they&apos;re banned

playerlist = { }
offenses = { }
banlist = { }

function oc(msg,speaker)
for i=1,#wordlist do
if string.lower(wordlist[i]) == string.lower(msg) then
local onum = 0
for i2=1,#playerlist do
if playerlist[i2] == speaker.Name then
offenses[i2] = offenses[i2] + 1
onum = offenses[i2]
break
end end
if onum &gt; warnings then
table.insert(banlist,speaker.Name)
speaker:remove()
else
local m = Instance.new(&quot;Message&quot;)
if warnings + 1 - onum == 1 then
m.Text = &quot;ODing is not allowed here&quot; -- you can change this , when players says a bad word this will pop up on srceen
else
m.Text = warnings + 1 - onum .. &quot;&quot;
end
m.Parent = speaker
wait(3)
if m ~= nil then
m:remove()
end end
return
end end end
game.Players.ChildAdded:connect(function(guy) if guy.className == &quot;Player&quot; then for i=1,#banlist do if banlist[i] == guy.Name then guy:remove() return end end table.insert(playerlist,guy.Name) table.insert(offenses,0) guy.Chatted:connect(function(msg) oc(msg,guy) end) end end)
game.Players.ChildRemoved:connect(function(guy) if guy.className == &quot;Player&quot; then for i=1,#playerlist do if playerlist[i] == guy.Name then table.remove(playerlist,i) table.remove(offenses,i) end end end end)</ProtectedString>
			</Properties>
		</Item>
