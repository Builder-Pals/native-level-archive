			<Item class="Script" referent="RBX4787">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Activate_Dance</string>
					<ProtectedString name="Source">local hb=script.Parent
local player=hb.Parent.Parent
local not_running=true

hb.Selected:connect(
function(mouse)
mouse.Button1Down:connect(
function()
if player.Character and not_running then
not_running=false
local dance=script.Dancinator:clone()
dance.Parent=player.Character
dance.Disabled=false
repeat wait()until player.Character:findFirstChild(&quot;Dancinator&quot;)==nil
not_running=true
end
end)
end)</ProtectedString>
				</Properties>
				<Item class="LocalScript" referent="RBX4788">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Dancinator</string>
						<ProtectedString name="Source">local myChar = script.Parent
if script.Parent ~= nil then
&#9;local myHum = script.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if myHum ~= nil then
&#9;&#9;newAnim = myHum:LoadAnimation(script.Boogie)
&#9;&#9;newAnim:Play()
&#9;end
&#9;script.BoogieSound:Play()
&#9;if myHum ~= nil then
&#9;&#9;wait(4)
&#9;&#9;myHum.Sit = true
&#9;&#9;myTorso = script.Parent:FindFirstChild(&quot;Torso&quot;)
&#9;&#9;local newBG = nil
&#9;&#9;if myTorso ~= nil then
&#9;&#9;&#9;newBG = Instance.new(&quot;BodyGyro&quot;)
&#9;&#9;&#9;newBG.P = 100000
&#9;&#9;&#9;newBG.maxTorque = Vector3.new(newBG.P, newBG.P, newBG.P)
&#9;&#9;&#9;newBG.cframe = myTorso.CFrame
&#9;&#9;&#9;newBG.Parent = myTorso
&#9;&#9;end
&#9;&#9;wait(1)
&#9;&#9;myHum.Sit = false
&#9;&#9;if newBG ~= nil then newBG:remove() end
&#9;end
end

wait(3)

script:remove()
</ProtectedString>
					</Properties>
