						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">--[[~-?stoeckerules?-~]]--
print(&quot;stoeckerules&apos;s Scripts&quot;)
local isOn = true

function on()
 isOn = true
 script.Parent.Transparency = 0 --Makes door NON-transparent.
 script.Parent.CanCollide = true --Makes door Collidable.
end

function off()
 isOn = false
 script.Parent.Transparency = .5 --Makes door transparent.
 script.Parent.CanCollide = false --Makes door uncollidable.
end

function onClicked()
 
 if isOn == true then off() else on() end

end

script.Parent.ClickDetector.MouseClick:connect(onClicked)

on()

--Even though on() looks usless, it NEEDS to be there. Please don&apos;t edit this.
--[[~-?stoeckerules?-~]]--












































--[[~-?stoeckerules?-~]]--

--I do this to make sure no one copys. :D
