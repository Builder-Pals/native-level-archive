							<ProtectedString name="Source">local drink = script.Parent.Parent.IceCreamCone3
local spot = script.Parent.Parent.Holder
local db = false

function onClick()
&#9;if db == false then
&#9;&#9;db = true
&#9;&#9;local d = drink:clone()
&#9;&#9;d.Handle.Position = spot.Position
&#9;&#9;d.Parent = game.Workspace
&#9;&#9;wait(0.5)
&#9;&#9;db = false
&#9;end
end

